# Shared release formatter profile. Keep consumer copies in sync with this file.
# Check: verible-verilog-format --flagfile=.verible.format --inplace --verify FILE...
# Apply: verible-verilog-format --flagfile=.verible.format --inplace FILE...
--column_limit=100
--indentation_spaces=2
--wrap_spaces=4
--assignment_statement_alignment=align
--port_declarations_alignment=align
--named_port_alignment=align
--named_parameter_alignment=align
